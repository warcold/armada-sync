{
  "$schema": "https://opencode.ai/config.json",
  "model": "vllm/nvidia/Qwen3.6-35B-A3B-NVFP4-normal",
  "instructions": [
    "/home/victoria/.config/opencode/AGENTS-summary.md",
    "/home/victoria/.config/opencode/todowrite-discipline.md"
  ],
  "default_agent": "Victoria",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "skills": {
    "auto-route": {
      "path": "/home/victoria/.victoria-custom/skills/auto-route"
    }
  },
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "· www.alfredo.pro",
      "options": {
        "baseURL": "http://127.0.0.1:8010/v1",
        "apiKey": "REDACTED",
        "timeout": 3600000,
        "chunkTimeout": 600000,
        "maxRetries": 3
      }
    },
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM (cloud)",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "timeout": 1800000,
        "chunkTimeout": 600000,
        "maxRetries": 3
      },
      "whitelist": [
        "deepseek-ai/deepseek-v4.1-flash",
        "z-ai/glm-5.3-flash",
        "nvidia/nemotron-3-ultra-550b-a55b"
      ]
    }
  }
}