{
  "$schema": "https://opencode.ai/config.json",
  "model": "vllm/nvidia/Qwen3.6-35B-A3B-NVFP4-normal",
  "instructions": [
    "/home/victoria/.config/opencode/AGENTS-summary.md",
    "/home/victoria/.config/opencode/todowrite-discipline.md"
  ],
  "default_agent": "Victoria",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "· www.alfredo.pro",
      "options": {
        "baseURL": "http://127.0.0.1:8010/v1",
        "apiKey": "REDACTED",
        "timeout": 3600000,
        "chunkTimeout": 600000,
        "maxRetries": 3
      },
      "models": {
        "nvidia/Qwen3.6-35B-A3B-NVFP4-normal": {
          "name": "Using a Victoria",
          "id": "nvidia/Qwen3.6-35B-A3B-NVFP4-normal",
          "limit": {"context": 220000, "output": 32000},
          "attachment": true,
          "tool_call": true,
          "reasoning": false,
          "modalities": {"input": ["text", "image", "video"], "output": ["text"]}
        },
        "NVFP4/Qwen3-Coder-30B-A3B-Instruct-FP4": {
          "name": "Coding con Victoria",
          "id": "NVFP4/Qwen3-Coder-30B-A3B-Instruct-FP4",
          "limit": {"context": 128000, "output": 32000},
          "attachment": false,
          "tool_call": true,
          "reasoning": false,
          "modalities": {"input": ["text"], "output": ["text"]}
        }
      }
    },
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM (cloud)",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "timeout": 1800000,
        "chunkTimeout": 600000,
        "maxRetries": 3
      },
      "whitelist": [
        "deepseek-ai/deepseek-v4.1-flash",
        "z-ai/glm-5.3-flash",
        "nvidia/nemotron-3-ultra-550b-a55b"
      ]
    }
  }
}
