#!/usr/bin/env python3
"""whisper-cli v2: STT via UNIX socket (raw audio, no multipart)."""
import argparse
import socket
import sys
import os

SOCKET_PATH = "/tmp/tts-gateway.sock"

def upload_raw_audio(audio_path, timeout=300):
    with open(audio_path, "rb") as f:
        audio_data = f.read()

    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(SOCKET_PATH)
        request = (
            f"POST /stt HTTP/1.1\r\n"
            f"Host: localhost\r\n"
            f"Content-Type: application/octet-stream\r\n"
            f"Content-Length: {len(audio_data)}\r\n"
            f"Connection: close\r\n"
            f"\r\n"
        ).encode('utf-8') + audio_data
        s.sendall(request)

        response = b""
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            response += chunk
        s.close()
        return response
    except Exception as e:
        s.close()
        print(f"error: {e}", file=sys.stderr)
        return None

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("audio", nargs="?", default=None)
    args = parser.parse_args()

    audio_path = args.audio
    if not audio_path or not os.path.isfile(audio_path):
        print("uso: whisper-cli <audio.wav>", file=sys.stderr)
        sys.exit(2)

    response = upload_raw_audio(audio_path)
    if response and response.startswith(b"HTTP/1.1 200"):
        idx = response.find(b"\r\n\r\n")
        if idx > 0:
            text = response[idx+4:].decode("utf-8", errors="replace").strip()
            print(text)
            sys.exit(0)

    print("error STT", file=sys.stderr)
    sys.exit(1)

if __name__ == "__main__":
    main()
