#!/usr/bin/env python3
"""victoria-tts: wrapper TTS de Victoria para OpenClaw (motor Qwen3-TTS, único motor).

Usa el bridge UNIX socket en /tmp/tts-gateway.sock para comunicar
con el voice-server del host a través del L7 proxy.
"""
import argparse
import json
import socket
import sys

SOCKET_PATH = "/tmp/tts-gateway.sock"

def post_json(path, data, timeout=420):
    """POST JSON data via UNIX socket to bridge."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(SOCKET_PATH)
        body = json.dumps(data).encode('utf-8')
        request = (
            f"POST {path} HTTP/1.1\r\n"
            f"Host: localhost\r\n"
            f"Content-Type: application/json\r\n"
            f"Content-Length: {len(body)}\r\n"
            f"Connection: close\r\n"
            f"\r\n"
        ).encode('utf-8') + body
        s.sendall(request)
        
        # Read response
        response = b""
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            response += chunk
        s.close()
        return response
    except Exception:
        s.close()
        return None

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--text", required=True)
    parser.add_argument("--out", "--output", required=True)
    parser.add_argument("--voice", default="victoria")
    parser.add_argument("--language", "--lang", default="es")
    args = parser.parse_args()

    data = {
        "text": args.text,
        "voice": args.voice,
        "language": args.language,
        "speaker": 0,
    }

    response = post_json("/tts", data, timeout=420)
    
    if response and response.startswith(b"HTTP/1.1 200") and args.out:
        # Extract body (after \r\n\r\n)
        idx = response.find(b"\r\n\r\n")
        if idx > 0:
            body = response[idx+4:]
            with open(args.out, "wb") as f:
                f.write(body)
            import os
            if os.path.getsize(args.out) > 0:
                sys.exit(0)
    
    print(f"error TTS (response: {response[:100] if response else 'none'})", file=sys.stderr)
    import os
    if os.path.exists(args.out):
        os.remove(args.out)
    sys.exit(1)

if __name__ == "__main__":
    main()
