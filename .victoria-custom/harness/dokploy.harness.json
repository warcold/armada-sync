{
  "name": "Dokploy",
  "description": "Gestiona Dokploy (PaaS self-hosted): proyectos, aplicaciones, compose, bases de datos, servidores, dominios, certificados, despliegues, backups, monitoreo. API key con header x-api-key.",
  "version": "1.0.0",
  "service": "dokploy",
  "ports": {
    "api": 3000,
    "ui_https": "dokploy.victoria.local (nginx -> 127.0.0.1:3000)"
  },
  "containers": [
    {
      "name": "dokploy",
      "image": "dokploy/dokploy:v0.31.4",
      "ports": [
        "3000:3000"
      ],
      "volumes": [
        "/var/run/docker.sock:/var/run/docker.sock",
        "dokploy-data:/data"
      ],
      "environment": {
        "ADMIN_EMAIL": "me@alfredo.pro",
        "ADMIN_PASSWORD": "${ADMIN_PASS}"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-f",
          "http://localhost:3000/api/trpc/project.all"
        ],
        "interval": "30s",
        "timeout": "10s",
        "retries": 3,
        "start_period": "30s"
      }
    },
    {
      "name": "dokploy-postgres",
      "image": "postgres:16-alpine",
      "ports": [
        "5432:5432"
      ],
      "volumes": [
        "dokploy-postgres:/var/lib/postgresql/data"
      ],
      "environment": {
        "POSTGRES_DB": "dokploy",
        "POSTGRES_USER": "dokploy",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}"
      }
    },
    {
      "name": "dokploy-redis",
      "image": "redis:7-alpine",
      "ports": [
        "6379:6379"
      ],
      "volumes": [
        "dokploy-redis:/data"
      ]
    },
    {
      "name": "dokploy-traefik",
      "image": "traefik:v3.1",
      "ports": [
        "80:80",
        "443:443",
        "8080:8080"
      ],
      "volumes": [
        "/var/run/docker.sock:/var/run/docker.sock:ro",
        "/etc/traefik:/etc/traefik:ro",
        "victoria-ssl-certs:/certs:ro"
      ],
      "command": [
        "--api.dashboard=true",
        "--api.insecure=true",
        "--providers.docker=true",
        "--providers.docker.exposedbydefault=false",
        "--entrypoints.web.address=:80",
        "--entrypoints.websecure.address=:443"
      ]
    }
  ],
  "volumes": [
    "dokploy-data",
    "dokploy-postgres",
    "dokploy-redis",
    "victoria-hf-cache",
    "victoria-voice-models",
    "victoria-comfyui-models",
    "victoria-liveportrait-weights",
    "victoria-sonic-weights",
    "victoria-hunyuan-weights",
    "victoria-voices",
    "victoria-ssl-certs",
    "victoria-victoria-custom",
    "victoria-logs",
    "victoria-armada-sync",
    "victoria-gateway-db",
    "victoria-openclaw-data",
    "victoria-n8n-data",
    "victoria-postgres",
    "victoria-redis"
  ],
  "networks": [
    "victoria-net"
  ],
  "api": {
    "base_url": "http://localhost:3000/api/trpc",
    "auth_header": "x-api-key",
    "api_key_file": "~/.victoria-custom/secrets/dokploy.api.key",
    "notes": "API key en harness obsoleto (dkp_victoria_...). La key real está en ~/.victoria-custom/secrets/dokploy.api.key. Key correcta activa y verificada 2026-11-21.",
    "working_queries": [
      "project.all",
      "server.all",
      "deployment.all",
      "application.all",
      "deployment.byProject",
      "network.all",
      "dockerVolume.all",
      "certificate.all",
      "domain.all",
      "compose.search",
      "deployment.all"
    ],
    "mutations": [
      "project.create",
      "project.update",
      "project.remove",
      "application.create",
      "application.update",
      "application.delete",
      "compose.create",
      "compose.update",
      "compose.redeploy",
      "network.create",
      "organization.update",
      "deployment.create",
      "deploy.compose"
    ],
    "non_existent": [
      "dockerVolume.all",
      "postgres.all",
      "redis.all",
      "backup.all",
      "schedule.all"
    ],
    "api_endpoints": {
      "vd-mailpit": "compose-victoria-core-mailpit",
      "vd-voice": "compose-victoria-skills-voice (N/A - service en host)",
      "vd-whois": "compose-victoria-skills-whois",
      "vd-video": "compose-victoria-skills-video",
      "vd-webnav": "compose-victoria-skills-webnav",
      "vd-gateway": "compose-victoria-core-gateway",
      "vd-comfyui": "compose-victoria-ai-comfyui",
      "vd-liveportrait": "compose-victoria-ai-liveportrait",
      "vd-sonic": "compose-victoria-ai-sonic",
      "vd-n8n": "compose-victoria-ai-n8n",
      "vd-hunyuan3d": "compose-victoria-ai-hunyuan3d",
      "vd-lp-animate": "compose-victoria-ai-lp-animate",
      "vd-redis": "compose-victoria-core-redis",
      "vd-postgres": "compose-victoria-core-postgres",
      "oc-publisher": "compose-victoria-agent-oc-publisher"
    }
  },
  "traefik_dynamic_configs": {
    "path": "/home/victoria/.victoria-custom/traefik/dynamic",
    "files": [
      "tls.yml",
      "middlewares.yml",
      "routes.yml"
    ],
    "mount_volume": "victoria-ssl-certs"
  },
  "projects_target": [
    {
      "name": "victoria-agent",
      "description": "OpenClaw agent platform (oc-publisher)",
      "applications": 0,
      "composes": 1,
      "container_ids": ["compose-victoria-agent-oc-publisher"]
    },
    {
      "name": "victoria-ai",
      "description": "AI/ML services (comfyui, liveportrait, sonic, n8n, hunyuan3d, lp-animate)",
      "applications": 0,
      "composes": 6,
      "container_ids": [
        "compose-victoria-ai-comfyui",
        "compose-victoria-ai-liveportrait",
        "compose-victoria-ai-sonic",
        "compose-victoria-ai-n8n",
        "compose-victoria-ai-hunyuan3d",
        "compose-victoria-ai-lp-animate"
      ],
      "gpu": true
    },
    {
      "name": "victoria-core",
      "description": "Core infrastructure (postgres, redis, gateway, mailpit)",
      "applications": 0,
      "composes": 4,
      "container_ids": [
        "compose-victoria-core-postgres",
        "compose-victoria-core-redis",
        "compose-victoria-core-gateway",
        "compose-victoria-core-mailpit"
      ]
    },
    {
      "name": "victoria-skills",
      "description": "Sentidos autonomos de Victoria (video, webnav, whois, voice)",
      "applications": 0,
      "composes": 4,
      "container_ids": [
        "compose-victoria-skills-voice",
        "compose-victoria-skills-video",
        "compose-victoria-skills-webnav",
        "compose-victoria-skills-whois"
      ],
      "gpu": true,
      "notes": "vd-voice eliminated: service runs on host via systemd (port conflict). vd-mailpit healthcheck fixed: curl → wget (2026-11-21)."
    }
  ],
  "healthchecks": {
    "vd-mailpit": {
      "compose_id": "compose-victoria-core-mailpit",
      "port": 8025,
      "cmd": "wget -q --spider http://localhost:8025/",
      "interval": "30s",
      "image": "axllent/mailpit",
      "status": "healthy",
      "fix_applied": "2026-11-21: curl → wget (mailpit no tiene curl)"
    },
    "vd-whois": {
      "compose_id": "compose-victoria-skills-whois",
      "port": 18830,
      "endpoint": "/health",
      "interval": "30s",
      "image": "victoria-whois:1.0",
      "status": "healthy",
      "note": "custom image, has curl"
    },
    "vd-video": {
      "compose_id": "compose-victoria-skills-video",
      "port": 18811,
      "endpoint": "/health",
      "interval": "30s",
      "image": "victoria-video:1.0",
      "status": "healthy",
      "note": "custom image, has curl"
    },
    "vd-webnav": {
      "compose_id": "compose-victoria-skills-webnav",
      "port": 18820,
      "endpoint": "/health",
      "interval": "30s",
      "image": "victoria-webnav:1.0",
      "status": "healthy",
      "note": "custom image, has curl"
    },
    "vd-gateway": {
      "compose_id": "compose-victoria-core-gateway",
      "port": 8010,
      "endpoint": "/health",
      "interval": "30s",
      "image": "victoria-gateway:1.0",
      "status": "healthy",
      "note": "custom image, has curl"
    },
    "vd-n8n": {
      "compose_id": "compose-victoria-ai-n8n",
      "port": 5678,
      "cmd": "wget -q --spider http://127.0.0.1:5678/healthz",
      "interval": "30s",
      "image": "n8nio/n8n",
      "status": "healthy"
    },
    "vd-sonic": {
      "compose_id": "compose-victoria-ai-sonic",
      "port": 18850,
      "endpoint": "/health",
      "interval": "30s",
      "image": "victoria-gpu-base:1.0",
      "status": "healthy",
      "note": "custom image, has curl"
    },
    "vd-liveportrait": {
      "compose_id": "compose-victoria-ai-liveportrait",
      "port": 8180,
      "endpoint": "/",
      "interval": "30s",
      "image": "victoria-gpu-base:1.0",
      "status": "healthy",
      "note": "custom image, has curl"
    },
    "vd-comfyui": {
      "compose_id": "compose-victoria-ai-comfyui",
      "port": 8188,
      "endpoint": "/system_stats",
      "interval": "30s",
      "image": "victoria-gpu-base:1.0",
      "status": "healthy",
      "note": "custom image, has curl"
    },
    "vd-hunyuan3d": {
      "compose_id": "compose-victoria-ai-hunyuan3d",
      "port": 18860,
      "endpoint": "/health",
      "interval": "30s",
      "image": "victoria-gpu-base:1.0",
      "status": "healthy",
      "note": "custom image, has curl"
    },
    "vd-lp-animate": {
      "compose_id": "compose-victoria-ai-lp-animate",
      "port": 18861,
      "endpoint": "/health",
      "interval": "30s",
      "image": "victoria-gpu-base:1.0",
      "status": "healthy",
      "note": "custom image, has curl"
    },
    "vd-redis": {
      "compose_id": "compose-victoria-core-redis",
      "cmd": "redis-cli ping",
      "interval": "30s",
      "image": "redis:7-alpine",
      "status": "healthy"
    },
    "vd-postgres": {
      "compose_id": "compose-victoria-core-postgres",
      "cmd": "pg_isready -U victoria -d victoria",
      "interval": "30s",
      "image": "postgres:16-alpine",
      "status": "healthy"
    },
    "vd-voice": {
      "compose_id": "compose-victoria-skills-voice",
      "status": "N/A - ELIMINADO",
      "reason": "vd-voice removed: conflicts with host victoria-voice-server.service (:18810). Voice service runs on host via systemd. Dokploy compose metadata preserved but container not managed.",
      "note": "python:3.12-slim has NO curl — would fail healthcheck if deployed. Also network_mode: host + docker creates port conflict."
    }
  },
  "scripts": {
    "validate_project": "docker exec dokploy curl -s -H \"x-api-key: $(cat ~/.victoria-custom/secrets/dokploy.api.key)\" \"http://localhost:3000/api/trpc/project.all\" | jq '.result.data.json[] | {projectId, name, description}'",
    "validate_compose": "docker exec dokploy curl -s -H \"x-api-key: $(cat ~/.victoria-custom/secrets/dokploy.api.key)\" \"http://localhost:3000/api/trpc/project.all\" | jq -c '.result.data.json[] | .environments[0].compose[] | {name, composeId, composeStatus}'"
  },
  "scripts_old_obsolete": [
    "validate_apps - usa dockerVolume.all que NO existe en Dokploy v0.31.x",
    "validate_volumes - usa dockerVolume.all que NO existe",
    "validate_networks - usa network.all con POST (debe ser GET con --data-urlencode input)",
    "validate_postgres - usa postgres.all que NO existe",
    "validate_redis - usa redis.all que NO existe"
  ],
  "best_practices": {
    "healthchecks": {
      "rule": "Usar wget o comando nativo para imágenes de Docker Hub. Usar curl SOLO para imágenes custom (victoria-*).",
      "examples": {
        "wget": "wget -q --spider http://localhost:8025/",
        "curl": "curl -f http://localhost:8025/",
        "native": "redis-cli ping / pg_isready -U user -d db",
        "python": "python3 -c \"import urllib.request; urllib.request.urlopen('http://localhost:port/health')\""
      },
      "note": "Dokploy no detecta cambios de archivos compose automaticamente — recrear contenedores manualmente con 'docker compose up -d' después de editar el compose file."
    },
    "resources": {
      "cpu_reservation": "Documentar en compose deploy.resources.reservations",
      "memory_limit": "Documentar en compose deploy.resources.reservations",
      "gpu": "Usar deploy.resources.reservations.devices para GPU (victoria-gpu-base usa 'all')"
    },
    "security": {
      "secrets": "Usar variables de entorno, NO hardcodear keys en compose files",
      "network": "Puertos solo en loopback (127.0.0.1) cuando sea posible",
      "labels": "Usar labels de dokploy para project/organization tracking"
    },
    "healthcheck_patterns": {
      "images_docker_hub": "wget -q --spider o comando nativo",
      "custom_victoria_images": "curl -f funciona (incluido en imagen)",
      "gpu_services": "Verificar endpoint específico del servicio",
      "databases": "pg_isready, redis-cli ping, mongoHealthCheck, etc."
    }
  },
  "changelog": "~/.victoria-custom/changelogs/CHANGELOG-dokploy.md",
  "agent_config": "~/.config/opencode/agents/dokploy.md",
  "docs": [
    "~/AGENTS.md §11",
    "~/.victoria-custom/harness/dokploy.harness.json"
  ],
  "known_issues": [
    "API key obsoleta en harness (dkp_victoria_...) — usar ~/.victoria-custom/secrets/dokploy.api.key",
    "vd-voice eliminado: servicio corre en host via systemd (puerto 18810 conflictivo)",
    "vd-mailpit healthcheck arreglado: curl → wget (2026-11-21)",
    "Dokploy no detecta cambios de archivos compose automaticamente — hay que recrear manualmente los contenedores con docker compose up -d",
    "Mutations via compose.redeploy funciona; compose.update no actualiza healthcheck de contenedores ya creados",
    "Routers inexistentes en Dokploy: dockerVolume.all, postgres.all, redis.all, backup.all, schedule.all"
  ],
  "migration_phases": [
    "Phase 0: Network + 14 bind-mount volumes + mkcert + backup",
    "Phase 1: victoria-agent (oc-publisher)",
    "Phase 2: victoria-ai (comfyui, liveportrait, sonic, n8n, hunyuan3d, lp-animate)",
    "Phase 3: victoria-core (postgres, redis, gateway, mailpit)",
    "Phase 4: victoria-skills (video, webnav, whois — voice eliminado, service en host)",
    "Phase 5: Cutover DNS + 24h validation + shutdown legacy"
  ],
  "migration_state": {
    "org": "Alfredo Pro LLC",
    "org_id": "cVKnzMSsWUDc2irlqgo-k",
    "projects_real": [
      "victoria-agent",
      "victoria-ai",
      "victoria-core",
      "victoria-skills"
    ],
    "projects_documented_old": [
      "victoria-shared",
      "victoria-gateway",
      "victoria-llm",
      "victoria-openclaw",
      "victoria-art"
    ],
    "status": "migration en curso - 4 proyectos activos, 15 composes, 0 apps individuales, 0 DBs",
    "vd_voice": "ELIMINADO - service en host via systemd",
    "vd_mailpit": "ARREGLADO - healthcheck curl → wget (2026-11-21)",
    "not_migrated": [
      "nemoclaw-vllm (nemoclaw)",
      "openshell sandbox",
      "host-admin (service en host)",
      "gpu-saver (service en host)"
    ]
  }
}