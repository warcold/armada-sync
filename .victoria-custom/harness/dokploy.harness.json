  "changelog": "~/.victoria-custom/changelogs/CHANGELOG-dokploy.md",
  "agent_config": "~/.config/opencode/agents/dokploy.md",
  "docs": [
    "~/AGENTS.md §11",
    "~/.victoria-custom/harness/dokploy.harness.json"
  ],
  "known_issues": [
    "bodyParser: false in tRPC handler - all mutations fail with 400",
    "Workaround: UI Web at http://victoria.local:8081 for all writes",
    "Read-only API works perfectly for validation"
  ],
  "migration_phases": [
    "Phase 0: Network + 14 bind-mount volumes + mkcert + backup",
    "Phase 1: victoria-shared (network, volumes, PG, Redis)",
    "Phase 2: victoria-infra (traefik, gpu-saver, cloudflared, armada-sync)",
    "Phase 3: victoria-llm (vllm-main, vllm-coder)",
    "Phase 4: victoria-gateway (api, admin, metering)",
    "Phase 5: victoria-openclaw (13 containers)",
    "Phase 6: victoria-art (7 containers)",
    "Phase 7: victoria-skills (5 containers)",
    "Phase 8: Cutover DNS + 24h validation + shutdown legacy"
  ],
