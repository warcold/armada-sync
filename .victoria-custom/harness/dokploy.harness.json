  "scripts": {
    "validate_project": "docker exec dokploy curl -s -H \"x-api-key: $DOKPLOY_KEY\" \"http://localhost:3000/api/trpc/project.all?batch=1\" | jq '.[][].result.data.json[] | {id, name, description}'",
    "validate_apps": "docker exec dokploy curl -s -H \"x-api-key: $DOKPLOY_KEY\" \"http://localhost:3000/api/trpc/application.search?batch=1&input={\\\"projectId\\\":\\\"<id>\\\",\\\"search\\\":\\\"\\\"}\" | jq '.[][].result.data.json[] | {id, name, dockerImage, ports}'",
    "validate_volumes": "docker exec dokploy curl -s -H \"x-api-key: $DOKPLOY_KEY\" \"http://localhost:3000/api/trpc/dockerVolume.all?batch=1\" | jq '.[][].result.data.json[] | {id, name, driver, driverOpts}'",
    "validate_networks": "docker exec dokploy curl -s -H \"x-api-key: $DOKPLOY_KEY\" \"http://localhost:3000/api/trpc/network.all?batch=1\" | jq '.[][].result.data.json[] | {id, name, driver, subnet}'",
    "validate_postgres": "docker exec dokploy curl -s -H \"x-api-key: $DOKPLOY_KEY\" \"http://localhost:3000/api/trpc/postgres.all?batch=1\" | jq '.[][].result.data.json[] | {id, name, database, username}'",
    "validate_redis": "docker exec dokploy curl -s -H \"x-api-key: $DOKPLOY_KEY\" \"http://localhost:3000/api/trpc/redis.all?batch=1\" | jq '.[][].result.data.json[] | {id, name, database}'"
  },
