{
  "name": "Dokploy",
  "description": "Gestiona Dokploy (PaaS self-hosted): proyectos, aplicaciones, compose, bases de datos, servidores, dominios, certificados, despliegues, backups, monitoreo. API key con header x-api-key.",
  "version": "1.0.0",
  "service": "dokploy",
  "ports": {
    "api": 3000,
    "ui_https": "dokploy.victoria.local (nginx -> 127.0.0.1:3000)"
  },
  "containers": [
    {
      "name": "dokploy",
      "image": "dokploy/dokploy:v0.31.4",
      "ports": [
        "3000:3000"
      ],
      "volumes": [
        "/var/run/docker.sock:/var/run/docker.sock",
        "dokploy-data:/data"
      ],
      "environment": {
        "ADMIN_EMAIL": "me@alfredo.pro",
        "ADMIN_PASSWORD": "${ADMIN_PASS}"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-f",
          "http://localhost:3000/api/trpc/project.all"
        ],
        "interval": "30s",
        "timeout": "10s",
        "retries": 3,
        "start_period": "30s"
      }
    },
    {
      "name": "dokploy-postgres",
      "image": "postgres:16-alpine",
      "ports": [
        "5432:5432"
      ],
      "volumes": [
        "dokploy-postgres:/var/lib/postgresql/data"
      ],
      "environment": {
        "POSTGRES_DB": "dokploy",
        "POSTGRES_USER": "dokploy",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}"
      }
    },
    {
      "name": "dokploy-redis",
      "image": "redis:7-alpine",
      "ports": [
        "6379:6379"
      ],
      "volumes": [
        "dokploy-redis:/data"
      ]
    },
    {
      "name": "dokploy-traefik",
      "image": "traefik:v3.1",
      "ports": [
        "80:80",
        "443:443",
        "8080:8080"
      ],
      "volumes": [
        "/var/run/docker.sock:/var/run/docker.sock:ro",
        "/etc/traefik:/etc/traefik:ro",
        "victoria-ssl-certs:/certs:ro"
      ],
      "command": [
        "--api.dashboard=true",
        "--api.insecure=true",
        "--providers.docker=true",
        "--providers.docker.exposedbydefault=false",
        "--entrypoints.web.address=:80",
        "--entrypoints.websecure.address=:443"
      ]
    }
  ],
  "volumes": [
    "dokploy-data",
    "dokploy-postgres",
    "dokploy-redis",
    "victoria-hf-cache",
    "victoria-voice-models",
    "victoria-comfyui-models",
    "victoria-liveportrait-weights",
    "victoria-sonic-weights",
    "victoria-hunyuan-weights",
    "victoria-voices",
    "victoria-ssl-certs",
    "victoria-victoria-custom",
    "victoria-logs",
    "victoria-armada-sync",
    "victoria-gateway-db",
    "victoria-openclaw-data",
    "victoria-n8n-data",
    "victoria-postgres",
    "victoria-redis"
  ],
  "networks": [
    "victoria-net"
  ],
  "api": {
    "base_url": "http://localhost:3000/api/trpc",
    "auth_header": "x-api-key",
    "api_key": "dkp_victoria_732596f16c2bfcde0f1452e2c0061ff5",
    "working_queries": [
      "project.all",
      "server.all",
      "postgres.all",
      "redis.all",
      "deployment.all",
      "backup.all",
      "schedule.all",
      "network.all",
      "dockerVolume.all",
      "application.all",
      "application.search",
      "certificate.all",
      "domain.all"
    ],
    "broken_mutations": [
      "project.create",
      "application.create",
      "postgres.create",
      "redis.create",
      "deployment.create",
      "backup.create",
      "schedule.create",
      "network.create",
      "dockerVolume.create",
      "certificate.create",
      "domain.create",
      "application.update",
      "project.update"
    ],
    "bug": "bodyParser: false in tRPC handler - JSON body not parsed"
  },
  "traefik_dynamic_configs": {
    "path": "/home/victoria/.victoria-custom/traefik/dynamic",
    "files": [
      "tls.yml",
      "middlewares.yml",
      "routes.yml"
    ],
    "mount_volume": "victoria-ssl-certs"
  },
  "projects_target": [
    {
      "name": "victoria-shared",
      "description": "Infra base: red, volúmenes bind-mount, PostgreSQL, Redis",
      "applications": 0,
      "resources": [
        "network",
        "volumes",
        "postgres",
        "redis"
      ]
    },
    {
      "name": "victoria-llm",
      "description": "Modelos LLM (vLLM Main + Coder)",
      "applications": 2,
      "containers": [
        "vllm-main",
        "vllm-coder"
      ],
      "gpu": true
    },
    {
      "name": "victoria-gateway",
      "description": "Gateway FastAPI (API + Admin + Metering)",
      "applications": 3,
      "containers": [
        "gateway-api",
        "gateway-admin",
        "gateway-metering"
      ]
    },
    {
      "name": "victoria-openclaw",
      "description": "Agente conversacional + habilidades",
      "applications": 13,
      "containers": [
        "openclaw-sandbox",
        "openclaw-publisher",
        "openclaw-voice",
        "openclaw-video",
        "openclaw-nav",
        "openclaw-whois",
        "openclaw-host-admin",
        "bridge-voice",
        "bridge-video",
        "bridge-nav",
        "bridge-whois",
        "bridge-admin",
        "blogwatcher",
        "openshell-proxy"
      ],
      "gpu": true
    },
    {
      "name": "victoria-art",
      "description": "Generación visual",
      "applications": 7,
      "containers": [
        "comfyui",
        "liveportrait",
        "sonic",
        "hunyuan3d",
        "lp-animate",
        "n8n"
      ],
      "gpu": true
    },
    {
      "name": "victoria-skills",
      "description": "Autonomía de Victoria",
      "applications": 5,
      "containers": [
        "victoria-voice",
        "victoria-video",
        "victoria-nav",
        "victoria-whois",
        "victoria-host-admin"
      ],
      "gpu": true
    },
    {
      "name": "victoria-infra",
      "description": "Infraestructura transversal",
      "applications": 4,
      "containers": [
        "traefik",
        "cloudflared",
        "gpu-saver",
        "armada-sync"
      ]
    }
  ],
