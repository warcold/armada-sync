#!/bin/bash
# cfmb25 - Clonar imagen FMB25 a tarjeta CUID via Proxmark3
# Uso: cfmb25                  → Clonar (con verificación previa de tarjeta)
# Uso: cfmb25 log              → Ver resumen del último intento
# Uso: cfmb25 logs            → Listar logs disponibles
# Uso: cfmb25 info            → Info de la tarjeta sin clonar

PROXMARK="/dev/ttyACM0"
PM3_BIN="/opt/proxmark3/client/proxmark3"
DUMP_FILE="$HOME/.proxmark3/dumps/FMB25.bin"
KEYS_FILE="$HOME/.proxmark3/dumps/FMB25-keys.bin"
LOG_DIR="$HOME/.proxmark3/logs/cfmb25"
PM3_LOGS="$HOME/.proxmark3/logs"
mkdir -p "$LOG_DIR"

# ─── Modo log: buscar en logs nativos del Proxmark3 ───
if [ "$1" = "log" ]; then
    # Buscar el último log del Proxmark3 relacionado con cfmb25 o restore
    LATEST=$(ls -t "$PM3_LOGS"/log_*.txt 2>/dev/null | head -1)
    if [ -z "$LATEST" ]; then
        echo "❌ No hay logs disponibles."
        exit 1
    fi

    # Buscar si hubo un intento de clonación reciente (últimos 5 logs)
    CLONE_FOUND=false
    for LOG in $(ls -t "$PM3_LOGS"/log_*.txt 2>/dev/null | head -5); do
        if grep -q "hf mf restore" "$LOG" 2>/dev/null; then
            LATEST="$LOG"
            CLONE_FOUND=true
            break
        fi
    done

    if [ "$CLONE_FOUND" = false ]; then
        echo "⚠️  No se encontró un intento de clonación reciente."
        echo "   Mostrando último log disponible:"
    fi

    LATEST_BASE=$(basename "$LATEST")
    echo "📄 Analizando log: $LATEST_BASE"
    echo "────────────────────────────────────────"
    echo ""

    # Extraer resumen del log
    BLOCKS_OK=$(grep -c "( ok )" "$LATEST" 2>/dev/null || true)
    BLOCKS_FAIL=$(grep -c "( fail )" "$LATEST" 2>/dev/null || true)
    AUTH_ERRORS=$(grep -c "Auth error" "$LATEST" 2>/dev/null || true)
    SELECT_ERRORS=$(grep -c "Can't select card" "$LATEST" 2>/dev/null || true)
    UID_FOUND=$(grep "UID:" "$LATEST" 2>/dev/null | head -1 || true)

    echo "📊 Resumen de clonación:"
    echo "   ✅ Bloques OK:      $BLOCKS_OK"
    echo "   ❌ Bloques FAIL:    $BLOCKS_FAIL"
    echo "   🔑 Errores auth:    $AUTH_ERRORS"
    echo "   🚫 No detectó card: $SELECT_ERRORS"
    [ -n "$UID_FOUND" ] && echo "   🎫 UID detectado:   $(echo "$UID_FOUND" | awk '{print $NF}')"
    echo ""

    # Diagnóstico
    if [ "$SELECT_ERRORS" -gt 0 ]; then
        echo "❌ DIAGNÓSTICO: El Proxmark3 no pudo seleccionar la tarjeta."
        echo "   → La tarjeta no responde al protocolo ISO14443-A"
        echo "   → No está sobre la antena o no es una tarjeta RFID MIFARE"
        echo ""
        echo "   ✅ Solución:"
        echo "      1. Colocá la tarjeta CUID centrada sobre la bobina del Proxmark3"
        echo "      2. Verificá que sea CUID/Magic (ATQA debe ser 00 00)"
        echo "      3. Ejecutá '$PM3_BIN /dev/ttyACM0 -c \"hf mf info\"' para verificar detección"
        echo "      4. No movés la tarjeta durante la escritura"
    elif [ "$AUTH_ERRORS" -gt 0 ]; then
        echo "❌ DIAGNÓSTICO: Errores de autenticación."
        echo "   → La tarjeta fue detectada pero las keys no coinciden"
        echo "   → La imagen FMB25 usa keys custom (F96D9D196F3A / FC696518BA91)"
        echo ""
        echo "   ✅ Solución:"
        echo "      1. La tarjeta podría tener keys diferentes a las del dump"
        echo "      2. Si es una CUID virgen, las keys por defecto son FFFFFFFFFFFF"
        echo "      3. Usá '$PM3_BIN /dev/ttyACM0 -c \"hf mf chk -k $KEYS_FILE\"' para verificar keys actuales"
    elif [ "$BLOCKS_FAIL" -gt 0 ] && [ "$SELECT_ERRORS" -eq 0 ] && [ "$AUTH_ERRORS" -eq 0 ]; then
        echo "⚠️  DIAGNÓSTICO: Bloques fallidos sin errores de auth ni selección."
        echo "   → Posible reinicio del Proxmark3 durante la escritura"
        echo "   → Verificar conexión USB del Proxmark3"
    elif [ "$BLOCKS_OK" -eq 64 ]; then
        echo "✅ CLONACIÓN EXITOSA (64/64 bloques OK)"
    else
        echo "⚠️  RESULTADO MIXTO: $BLOCKS_OK OK / $BLOCKS_FAIL FAIL"
        echo "   Revisá el log completo para detalles:"
        echo "   → cat $LATEST"
    fi
    echo ""
    echo "📄 Log completo: $LATEST"
    exit 0
fi

if [ "$1" = "logs" ]; then
    echo "📂 Últimos logs del Proxmark3:"
    ls -lt "$PM3_LOGS"/log_*.txt 2>/dev/null | head -10
    echo ""
    echo "📂 Resumen de cfmb25:"
    for LOG in $(ls -t "$PM3_LOGS"/log_*.txt 2>/dev/null | head -5); do
        BASE=$(basename "$LOG")
        if grep -q "hf mf restore" "$LOG" 2>/dev/null; then
            OK=$(grep -c "( ok )" "$LOG" 2>/dev/null || true)
            FAIL=$(grep -c "( fail )" "$LOG" 2>/dev/null || true)
            echo "  📄 $BASE → ✅$OK ❌$FAIL"
        fi
    done
    exit 0
fi

if [ "$1" = "info" ]; then
    echo "🔍 Info de la tarjeta (sin clonar):"
    echo ""
    "$PM3_BIN" "$PROXMARK" -c "hf mf info" 2>&1 | grep -E "(UID|ATQA|SAK|Magic|PRNG|type|fingerprint|Info)" || echo "   ⚠️ No se detectó tarjeta"
    exit 0
fi

# ─── MODO CLONACIÓN ───
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
LOG_FILE="$LOG_DIR/cfmb25_${TIMESTAMP}.log"

log_msg() {
    local msg="[$(date '+%H:%M:%S')] $1"
    echo "$msg" | tee -a "$LOG_FILE"
}

log_msg "📡 Iniciando clonación FMB25..."
log_msg "   Imagen: $DUMP_FILE"
log_msg "   Keys:   $KEYS_FILE"
log_msg "   Proxmark: $PROXMARK"
echo ""

# Verificar Proxmark3
if ! ls "$PROXMARK" &>/dev/null; then
    log_msg "❌ Error: Proxmark3 no conectado en $PROXMARK"
    exit 1
fi

# Verificar archivos
if [ ! -f "$DUMP_FILE" ]; then
    log_msg "❌ Error: Archivo de imagen no encontrado: $DUMP_FILE"
    exit 1
fi

if [ ! -f "$KEYS_FILE" ]; then
    log_msg "❌ Error: Archivo de keys no encontrado: $KEYS_FILE"
    exit 1
fi

# ─── PASO 1: Verificar que la tarjeta esté sobre la antena ───
log_msg "🔍 Verificando tarjeta en antena..."
echo ""

CARD_INFO=$("$PM3_BIN" "$PROXMARK" -c "hf mf info" 2>&1)
CARD_UID=$(echo "$CARD_INFO" | grep -oP 'UID:\s*\K\S+' || true)

if [ -z "$CARD_UID" ]; then
    log_msg "❌ Error: No se detectó ninguna tarjeta sobre la antena."
    log_msg "   Solución: Colocá la tarjeta CUID centrada sobre la bobina del Proxmark3"
    log_msg "   💡 No mové la tarjeta hasta que termine la clonación"
    echo ""
    log_msg "   💡 Para verificar manualmente: $PM3_BIN /dev/ttyACM0 -c 'hf mf info'"
    exit 1
fi

log_msg "   ✅ Tarjeta detectada: UID $CARD_UID"
echo "$CARD_INFO" | grep -E "(UID|ATQA|SAK|Magic|PRNG)" | sed 's/^/   /'
echo ""

# ─── PASO 2: Clonar ───
log_msg "📝 Clonando imagen a tarjeta (64 bloques)..."
echo ""

# Ejecutar clonación: proxmark3 escribe su propio log en ~/.proxmark3/logs/
# Capturamos el stdout y stderr para ver progreso en tiempo real
"$PM3_BIN" "$PROXMARK" -c "hf mf restore --1k -f $DUMP_FILE -k $KEYS_FILE --ka" 2>&1 || true

echo ""
log_msg "📊 Analizando resultados (logs nativos del Proxmark3)..."

# Buscar el log del Proxmark3 generado durante la clonación (último log modificado)
CLONE_LOG=$(ls -t "$PM3_LOGS"/log_*.txt 2>/dev/null | head -1)

if [ -f "$CLONE_LOG" ]; then
    BLOCKS_OK=$(grep -c "( ok )" "$CLONE_LOG" 2>/dev/null || true)
    BLOCKS_FAIL=$(grep -c "( fail )" "$CLONE_LOG" 2>/dev/null || true)
    AUTH_ERRORS=$(grep -c "Auth error" "$CLONE_LOG" 2>/dev/null || true)
    SELECT_ERRORS=$(grep -c "Can't select card" "$CLONE_LOG" 2>/dev/null || true)

    log_msg "   ✅ Bloques OK:      $BLOCKS_OK"
    log_msg "   ❌ Bloques FAIL:    $BLOCKS_FAIL"
    log_msg "   🔑 Errores auth:    $AUTH_ERRORS"
    log_msg "   🚫 No detectó card: $SELECT_ERRORS"
    echo ""
else
    log_msg "   ⚠️  No se encontró log del Proxmark3"
    log_msg "   Intentá con: cfmb25 log (para analizar logs anteriores)"
fi

# ─── DIAGNÓSTICO FINAL ───
if [ -f "$CLONE_LOG" ]; then
    if [ "$SELECT_ERRORS" -gt 0 ]; then
        log_msg "❌ FATAL: El Proxmark3 no pudo seleccionar la tarjeta."
        log_msg "   → La tarjeta no responde al protocolo ISO14443-A"
        log_msg "   → No es una tarjeta CUID/Magic o no está bien posicionada"
        log_msg "   💡 Solución: cfmb25 info (para verificar tipo de tarjeta)"
    elif [ "$AUTH_ERRORS" -gt 0 ]; then
        log_msg "❌ Errores de autenticación detectados."
        log_msg "   → La imagen FMB25 usa keys custom: F96D9D196F3A / FC696518BA91"
        log_msg "   → Si la tarjeta tiene keys diferentes, esos sectores fallarán"
        log_msg "   💡 Solución: Verificar keys con: cfmb25 info"
    elif [ "$BLOCKS_FAIL" -gt 0 ] && [ "$AUTH_ERRORS" -eq 0 ] && [ "$SELECT_ERRORS" -eq 0 ]; then
        log_msg "⚠️  Posible reinicio del Proxmark3 durante escritura."
        log_msg "   → Verificar conexión USB del Proxmark3"
    elif [ "$BLOCKS_OK" -eq 64 ]; then
        log_msg "✅ Clonación completada exitosamente (64/64 bloques OK)."
        log_msg "   💡 Verificar con: $PM3_BIN $PROXMARK -c 'hf mf dump --ns -k $KEYS_FILE'"
    else
        log_msg "⚠️  Resultado mixto: $BLOCKS_OK OK / $BLOCKS_FAIL FAIL"
        log_msg "   💡 Ver log completo: cfmb25 log"
    fi
    log_msg "   📄 Log completo: $CLONE_LOG"
fi
